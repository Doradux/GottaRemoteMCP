{
  "name": "gotta-remote-mcp",
  "version": "0.3.0",
  "description": "Zero-API Remote Desktop Commander for normal ChatGPT & Gemini chats via bash-generated credentials + MCP",
  "main": "dist/index.js",
  "bin": {
    "gotta-remote-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:local": "node dist/index.js --no-tunnel",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "screenshot-desktop": "^1.15.0",
    "ssh2": "^1.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
